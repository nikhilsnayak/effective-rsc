{
  "name": "effective-rsc-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "examples/*",
    "fixtures/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "docs:check": "bun scripts/generate-docs.ts --check",
    "docs:generate": "bun scripts/generate-docs.ts",
    "lint": "oxlint --deny-warnings --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt . '!vendor/**'",
    "fmt:check": "oxfmt --check . '!vendor/**'",
    "release": "bash scripts/release.sh",
    "check": "bun run lint && bun run fmt:check && bun run docs:check",
    "test": "turbo test test:types test:e2e",
    "test:e2e": "turbo test:e2e",
    "test:watch": "turbo test:watch",
    "vendor:sync": "bun scripts/sync-vendor.ts",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.37.0",
    "@types/bun": "catalog:",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@base-ui/react": "^1.7.0",
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@playwright/test": "1.62.1",
    "@rslib/core": "1.0.0-rc.2",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.112",
    "lucide-react": "^1.34.0",
    "react": "19.3.0-canary-a1124489-20260826",
    "react-dom": "19.3.0-canary-a1124489-20260826",
    "react-server-dom-rspack": "0.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
