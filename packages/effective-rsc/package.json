{
  "name": "effective-rsc",
  "version": "0.1.0",
  "description": "An experimental, Effect-native React Server Components framework for Bun",
  "keywords": [
    "bun",
    "effect",
    "react-server-components"
  ],
  "homepage": "https://github.com/nikhilsnayak/effective-rsc#readme",
  "bugs": {
    "url": "https://github.com/nikhilsnayak/effective-rsc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikhilsnayak/effective-rsc.git",
    "directory": "packages/effective-rsc"
  },
  "bin": {
    "ersc": "./bin/ersc.js"
  },
  "files": [
    "bin/ersc.js",
    "dist",
    "docs",
    "LICENSE",
    "LLMS.md",
    "logo-dark.svg",
    "logo.svg",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.js",
      "default": "./dist/unsupported.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "docs:check": "bun ../../scripts/generate-docs.ts --check",
    "prepack": "bun run build && bun run docs:check",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rspack/core": "2.2.0",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@tailwindcss/webpack": "4.3.3",
    "react-refresh": "0.18.0",
    "rsc-html-stream": "0.0.8"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-rspack": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-rspack": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
