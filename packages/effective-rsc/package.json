{
  "name": "effective-rsc",
  "version": "0.0.0",
  "license": "MIT",
  "bin": {
    "ersc": "./bin/ersc.js"
  },
  "files": [
    "bin/ersc.js",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.js",
      "default": "./dist/unsupported.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "prepack": "bun run build",
    "test": "vitest run --exclude tests/build/distribution.test.ts",
    "test:dist": "vitest run tests/build/distribution.test.ts",
    "test:pack": "bun pm pack --dry-run --ignore-scripts --quiet",
    "test:watch": "vitest --exclude tests/build/distribution.test.ts"
  },
  "dependencies": {
    "@rspack/core": "2.2.0-rc.0",
    "@tailwindcss/webpack": "4.3.3",
    "rsc-html-stream": "0.0.8"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "1.0.0-rc.1",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "19.2.4",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-rspack": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-rspack": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
