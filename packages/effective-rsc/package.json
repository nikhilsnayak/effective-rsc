{
  "name": "effective-rsc",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikhilsnayak/effective-rsc.git",
    "directory": "packages/effective-rsc"
  },
  "bin": {
    "ersc": "./bin/ersc.js"
  },
  "files": [
    "bin/ersc.js",
    "dist",
    "docs",
    "LICENSE",
    "LLMS.md",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.js",
      "default": "./dist/unsupported.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "docs:check": "bun ../../scripts/generate-docs.ts --check",
    "prepack": "bun run build && bun run docs:check",
    "test": "vitest run --exclude tests/build/distribution.test.ts && bun run test:docs",
    "test:docs": "tsc --project tsconfig.docs.json",
    "test:dist": "vitest run tests/build/distribution.test.ts",
    "test:pack": "bun pm pack --dry-run --ignore-scripts --quiet",
    "test:watch": "vitest --exclude tests/build/distribution.test.ts"
  },
  "dependencies": {
    "@rspack/core": "2.2.0",
    "@tailwindcss/webpack": "4.3.3",
    "rsc-html-stream": "0.0.8"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-rspack": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-rspack": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
