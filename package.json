{
  "name": "effective-rsc-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "examples/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "docs:check": "bun scripts/generate-docs.ts --check",
    "docs:generate": "bun scripts/generate-docs.ts",
    "lint": "oxlint --deny-warnings --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt . '!repos/**'",
    "fmt:check": "oxfmt --check . '!repos/**'",
    "check": "bun run lint && bun run fmt:check && bun run docs:check",
    "test": "turbo test test:dist test:pack && turbo test:e2e && bun run test:scripts",
    "test:e2e": "turbo test:e2e",
    "test:scripts": "vitest run scripts",
    "test:watch": "turbo test:watch",
    "vendor:sync": "bun scripts/sync-vendor.ts",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@types/bun": "catalog:",
    "oxfmt": "^0.65.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@rslib/core": "1.0.0-rc.1",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "effect": "4.0.0-rc.112",
    "react": "19.3.0-canary-eb8feb71-20260814",
    "react-dom": "19.3.0-canary-eb8feb71-20260814",
    "react-server-dom-rspack": "0.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
